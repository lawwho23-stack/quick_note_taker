# Quick Note API — environment example.
# Copy to backend/.env for local development. Never commit real .env files.

APP_ENV=local
LOG_LEVEL=INFO

# Local Supabase Auth (supabase start prints the local values).
# Staging/production uses https://<project-ref>.supabase.co with the project anon key.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# The API's runtime connection. Locally the local Supabase Postgres is fine.
# Staging/production: use the transaction pooler (port 6543) with the qn_runtime role.
RUNTIME_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Owner/migration connection. Used by scripts only; never by the running API.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Website origin: used for post-login redirects and the CSRF origin allowlist.
WEB_BASE_URL=http://localhost:3000
WEB_ORIGIN_ALLOWLIST=http://localhost:3000

# Cookies: false for local http, true on staging/production https.
COOKIES_SECURE=false
