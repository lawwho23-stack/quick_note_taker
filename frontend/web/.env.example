# Base URL of the FastAPI backend. Next.js forwards /api/v1/* to <base>/v1/*.
# Local: the dev API (uv run uvicorn app.main:app --port 8000)
# Staging: https://quick-note-api.vercel.app (or the project's own domain)
QUICK_NOTE_API_URL=http://127.0.0.1:8000

# Chrome/Edge extension the website talks to (chrome.runtime.sendMessage).
# Stable because of the `key` in frontend/extension/manifest.json.
NEXT_PUBLIC_EXTENSION_ID=mpnpdndkgajhjmlefflhemibjmkkcnha

# Optional: the Chrome Web Store / Edge Add-ons listing. Until it is set,
# /quick-note offers the zip download and "Load unpacked" steps.
# NEXT_PUBLIC_EXTENSION_STORE_URL=https://chromewebstore.google.com/detail/<id>

# Optional: where the extension zip is downloaded from. Default: the latest
# GitHub Release (built by .github/workflows/extension-release.yml).
# NEXT_PUBLIC_EXTENSION_DOWNLOAD_URL=https://github.com/lawwho23-stack/quick_note_taker/releases/latest/download/quick-note-extension.zip
