{
  "name": "@quick-note/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "devDependencies": {
    "openapi-typescript": "^7.4.4"
  },
  "scripts": {
    "gen:api": "openapi-typescript ../../backend/openapi.json -o src/api.gen.ts",
    "check:api": "openapi-typescript ../../backend/openapi.json -o /tmp/qn-api.gen.ts && diff -q src/api.gen.ts /tmp/qn-api.gen.ts"
  }
}
