{
  "manifest_version": 3,
  "name": "Quick Note (M0 bridge test)",
  "version": "0.1.0",
  "description": "M0 prototype: verifies the Space+N bridge and opens the capture window.",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Quick Note capture (manual test)"
  },
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8787/*"],
  "commands": {
    "open-capture": {
      "suggested_key": {
        "default": "Ctrl+Shift+7",
        "mac": "MacCtrl+Shift+7"
      },
      "description": "Open Quick Note capture (M0 bridge test)"
    }
  }
}
